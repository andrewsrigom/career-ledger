{
  "name": "career-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private-first engineering career ledger with a sanitized static public portfolio.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node --experimental-strip-types scripts/career.ts init && node --experimental-strip-types scripts/career.ts hooks",
    "dev": "node --experimental-strip-types scripts/dev-server.ts",
    "dev:preview": "node --experimental-strip-types scripts/dev-server.ts --preview",
    "build": "node --experimental-strip-types scripts/career.ts build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --project tsconfig.node.json && node --experimental-strip-types scripts/astro-check.ts",
    "check": "node --experimental-strip-types scripts/career.ts validate && node --experimental-strip-types scripts/career.ts audit && npm run typecheck && npm test && npm run build",
    "check:browser": "playwright test",
    "career": "node --experimental-strip-types scripts/career.ts",
    "career:init": "node --experimental-strip-types scripts/career.ts init",
    "career:doctor": "node --experimental-strip-types scripts/career.ts doctor",
    "career:scan": "node --experimental-strip-types scripts/career.ts scan",
    "career:review": "node --experimental-strip-types scripts/career.ts review",
    "career:media-review": "node --experimental-strip-types scripts/media-inventory.ts",
    "career:validate": "node --experimental-strip-types scripts/career.ts validate",
    "career:audit": "node --experimental-strip-types scripts/career.ts audit",
    "career:publish": "node --experimental-strip-types scripts/career.ts publish",
    "career:preview": "node --experimental-strip-types scripts/career.ts preview",
    "career:approve": "node --experimental-strip-types scripts/career.ts approve",
    "career:hooks": "node --experimental-strip-types scripts/career.ts hooks",
    "career:validate-private": "node --experimental-strip-types scripts/career.ts validate-private"
  },
  "dependencies": {
    "astro": "^7.2.8",
    "gsap": "^3.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "typescript": "^6.0.3"
  }
}
