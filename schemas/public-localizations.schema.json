{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-localizations.schema.json",
  "title": "Public record localizations",
  "$defs": {
    "translatedTextList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      }
    },
    "localizedPrinciple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 20, "maxLength": 300 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pt-BR": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline", "location", "intro", "bio", "principles", "links"],
          "properties": {
            "headline": { "type": "string", "minLength": 4, "maxLength": 120 },
            "location": { "type": "string", "maxLength": 120 },
            "intro": { "type": "string", "minLength": 30, "maxLength": 500 },
            "bio": { "$ref": "#/$defs/translatedTextList" },
            "links": { "$ref": "#/$defs/translatedTextList" },
            "principles": {
              "type": "array",
              "items": { "$ref": "#/$defs/localizedPrinciple" }
            }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pt-BR": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "periodLabel", "summary", "contributions", "outcomes", "links"],
          "properties": {
            "title": { "type": "string", "minLength": 4, "maxLength": 120 },
            "periodLabel": { "type": "string", "minLength": 4, "maxLength": 80 },
            "summary": { "type": "string", "minLength": 40, "maxLength": 500 },
            "context": { "type": "string", "minLength": 20, "maxLength": 1200 },
            "contributions": { "$ref": "#/$defs/translatedTextList" },
            "outcomes": { "$ref": "#/$defs/translatedTextList" },
            "links": { "$ref": "#/$defs/translatedTextList" }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pt-BR": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "summary", "description", "links"],
          "properties": {
            "name": { "type": "string", "minLength": 2, "maxLength": 100 },
            "summary": { "type": "string", "minLength": 30, "maxLength": 400 },
            "description": { "type": "string", "minLength": 40, "maxLength": 1500 },
            "previewAlt": { "type": "string", "minLength": 8, "maxLength": 240 },
            "links": { "$ref": "#/$defs/translatedTextList" }
          }
        }
      }
    },
    "localizedExperience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "location", "domain", "periodLabel", "summary", "contributions", "outcomes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "role": { "type": "string", "minLength": 4, "maxLength": 120 },
        "location": { "type": "string", "maxLength": 120 },
        "domain": { "type": "string", "minLength": 4, "maxLength": 160 },
        "periodLabel": { "type": "string", "minLength": 4, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 40, "maxLength": 500 },
        "contributions": { "$ref": "#/$defs/translatedTextList" },
        "outcomes": { "$ref": "#/$defs/translatedTextList" }
      }
    },
    "localizedEducation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "credential", "institution", "periodLabel"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "credential": { "type": "string", "minLength": 4, "maxLength": 160 },
        "institution": { "type": "string", "minLength": 2, "maxLength": 160 },
        "periodLabel": { "type": "string", "minLength": 4, "maxLength": 80 }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pt-BR": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "highlights", "skills", "experiences", "education"],
          "properties": {
            "summary": { "type": "string", "minLength": 50, "maxLength": 800 },
            "highlights": { "$ref": "#/$defs/translatedTextList" },
            "skills": { "$ref": "#/$defs/translatedTextList" },
            "experiences": {
              "type": "array",
              "items": { "$ref": "#/$defs/localizedExperience" }
            },
            "education": {
              "type": "array",
              "items": { "$ref": "#/$defs/localizedEducation" }
            }
          }
        }
      }
    },
    "localizedArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "label", "description"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 20, "maxLength": 300 }
      }
    },
    "localizedKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "description"],
      "properties": {
        "value": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 15, "maxLength": 240 }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pt-BR": {
          "type": "object",
          "additionalProperties": false,
          "required": ["areas", "kinds"],
          "properties": {
            "areas": {
              "type": "array",
              "items": { "$ref": "#/$defs/localizedArea" }
            },
            "kinds": {
              "type": "array",
              "items": { "$ref": "#/$defs/localizedKind" }
            }
          }
        }
      }
    }
  }
}
