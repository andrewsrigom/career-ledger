{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-project.schema.json",
  "title": "Public career project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "id",
    "slug",
    "name",
    "kind",
    "status",
    "summary",
    "description",
    "areas",
    "technologies",
    "relatedEntries",
    "featured",
    "publication",
    "links"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "project"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "kind": {
      "enum": [
        "application",
        "open-source",
        "platform",
        "product",
        "research",
        "tool"
      ]
    },
    "status": {
      "enum": [
        "active",
        "completed",
        "archived",
        "paused"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 400
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1500
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "technologies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "relatedEntries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "featured": {
      "type": "boolean"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sanitized",
        "reviewedAt",
        "approvedBy"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "approved"
          ]
        },
        "sanitized": {
          "type": "boolean"
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "href": {
            "type": "string",
            "pattern": "^(https://|mailto:)"
          }
        }
      }
    }
  }
}
