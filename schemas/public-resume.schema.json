{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-resume.schema.json",
  "title": "Public career resume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "id",
    "slug",
    "experienceStart",
    "summary",
    "highlights",
    "skills",
    "experiences",
    "education",
    "publication"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "resume"
    },
    "id": {
      "const": "resume"
    },
    "slug": {
      "const": "resume"
    },
    "experienceStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 50,
      "maxLength": 800
    },
    "highlights": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "activityMix": {
      "$ref": "public-presentation.schema.json#/$defs/activityMix"
    },
    "experiences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/experience"
      }
    },
    "education": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/education"
      }
    },
    "recommendations": {
      "type": "array", "maxItems": 12,
      "items": { "$ref": "#/$defs/recommendation" }
    },
    "contact": { "$ref": "#/$defs/contact" },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "localizations": {
      "$ref": "public-localizations.schema.json#/$defs/resume"
    }
  },
  "$defs": {
    "contact": {
      "type": "object", "additionalProperties": false, "required": ["links"],
      "properties": {
        "email": { "type": "string", "maxLength": 254, "pattern": "^[a-zA-Z0-9.!#$&'*+\\/=^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)+$" },
        "phone": { "type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$" },
        "whatsapp": { "type": "boolean" },
        "links": { "type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "href"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "href": { "type": "string", "minLength": 12, "maxLength": 300, "pattern": "^https://[^\\s?#@]+$" }
          }
        } }
      },
      "if": { "required": ["whatsapp"] },
      "then": { "required": ["phone"] }
    },
    "recommendationUrl": {
      "type": "string", "minLength": 12, "maxLength": 300,
      "pattern": "^https://(?:www\\.)?linkedin\\.com/in/[a-zA-Z0-9%-]+/(?:details/recommendations/)?$"
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "relationship", "quote", "profileUrl", "sourceUrl"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "relationship": { "type": "string", "minLength": 4, "maxLength": 160 },
        "quote": { "type": "string", "minLength": 30, "maxLength": 700 },
        "profileUrl": { "$ref": "#/$defs/recommendationUrl" },
        "sourceUrl": { "$ref": "#/$defs/recommendationUrl" },
        "portrait": {
          "type": "object", "additionalProperties": false,
          "required": ["src", "width", "height", "approval"],
          "description": "A square, owner-approved local WebP portrait, at most 50 KB. Runtime validation also verifies square dimensions.",
          "properties": {
            "src": { "type": "string", "maxLength": 160, "pattern": "^assets/portraits/[a-z0-9][a-z0-9._-]*\\.webp$" },
            "width": { "type": "integer", "minimum": 64, "maximum": 512 },
            "height": { "type": "integer", "minimum": 64, "maximum": 512 },
            "approval": {
              "type": "object", "additionalProperties": false, "required": ["approvedBy", "reviewedAt"],
              "properties": {
                "approvedBy": { "const": "owner" },
                "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          }
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "label"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "label": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceLevel"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 15,
          "maxLength": 300
        },
        "evidenceLevel": {
          "enum": [
            "observed",
            "measured",
            "self-reported",
            "public"
          ]
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization",
        "role",
        "engagement",
        "location",
        "domain",
        "period",
        "summary",
        "contributions",
        "outcomes",
        "technologies",
        "relatedProjects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "organization": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        },
        "engagement": {
          "enum": [
            "full-time",
            "contract",
            "independent"
          ]
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "domain": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "summary": {
          "type": "string",
          "minLength": 40,
          "maxLength": 500
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 15,
            "maxLength": 300
          }
        },
        "outcomes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "technologies": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "relatedProjects": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "credential",
        "institution",
        "period"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "credential": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "institution": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "period": {
          "$ref": "#/$defs/period"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sanitized",
        "reviewedAt",
        "approvedBy"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "approved"
          ]
        },
        "sanitized": {
          "type": "boolean"
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    }
  }
}
