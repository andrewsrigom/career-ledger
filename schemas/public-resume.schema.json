{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-resume.schema.json",
  "title": "Public career resume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "id",
    "slug",
    "experienceStart",
    "summary",
    "highlights",
    "skills",
    "experiences",
    "education",
    "publication"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "resume"
    },
    "id": {
      "const": "resume"
    },
    "slug": {
      "const": "resume"
    },
    "experienceStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 50,
      "maxLength": 800
    },
    "highlights": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "activityMix": {
      "$ref": "public-presentation.schema.json#/$defs/activityMix"
    },
    "experiences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/experience"
      }
    },
    "education": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/education"
      }
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "localizations": {
      "$ref": "public-localizations.schema.json#/$defs/resume"
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "label"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "label": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceLevel"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 15,
          "maxLength": 300
        },
        "evidenceLevel": {
          "enum": [
            "observed",
            "measured",
            "self-reported",
            "public"
          ]
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organization",
        "role",
        "engagement",
        "location",
        "domain",
        "period",
        "summary",
        "contributions",
        "outcomes",
        "technologies",
        "relatedProjects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "organization": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        },
        "engagement": {
          "enum": [
            "full-time",
            "contract",
            "independent"
          ]
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "domain": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "summary": {
          "type": "string",
          "minLength": 40,
          "maxLength": 500
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 15,
            "maxLength": 300
          }
        },
        "outcomes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "technologies": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "relatedProjects": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "credential",
        "institution",
        "period"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "credential": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "institution": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "period": {
          "$ref": "#/$defs/period"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sanitized",
        "reviewedAt",
        "approvedBy"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "approved"
          ]
        },
        "sanitized": {
          "type": "boolean"
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    }
  }
}
