{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/profile.schema.json",
  "title": "Public profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "headline",
    "location",
    "intro",
    "bio",
    "links",
    "principles",
    "updatedAt"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "headline": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "location": {
      "type": "string",
      "maxLength": 120
    },
    "intro": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500
    },
    "bio": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 30,
        "maxLength": 800
      }
    },
    "links": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "href": {
            "type": "string",
            "pattern": "^(https://|mailto:)"
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          }
        }
      }
    },
    "localizations": {
      "$ref": "public-localizations.schema.json#/$defs/profile"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
