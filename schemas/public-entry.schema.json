{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-entry.schema.json",
  "title": "Public career entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "id",
    "slug",
    "title",
    "kind",
    "status",
    "period",
    "summary",
    "contributions",
    "outcomes",
    "areas",
    "technologies",
    "featured",
    "publication",
    "links"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "entry"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "kind": {
      "enum": [
        "architecture",
        "improvement",
        "investigation",
        "launch",
        "leadership",
        "learning",
        "project",
        "reliability",
        "research"
      ]
    },
    "status": {
      "enum": [
        "active",
        "completed",
        "archived"
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "label"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "label": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 500
    },
    "context": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 15,
        "maxLength": 300
      }
    },
    "outcomes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceLevel"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 15,
            "maxLength": 300
          },
          "evidenceLevel": {
            "enum": [
              "observed",
              "measured",
              "self-reported",
              "public"
            ]
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "technologies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "featured": {
      "type": "boolean"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sanitized",
        "reviewedAt",
        "approvedBy"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "approved"
          ]
        },
        "sanitized": {
          "type": "boolean"
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "href": {
            "type": "string",
            "pattern": "^(https://|mailto:)"
          }
        }
      }
    }
  }
}
