{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/public-presentation.schema.json",
  "title": "Reviewed portfolio presentation metadata",
  "$defs": {
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview"],
      "properties": {
        "gallery": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/galleryImage" } },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "alt"],
          "properties": {
            "kind": { "enum": ["image", "diagram"] },
            "src": {
              "type": "string",
              "pattern": "^assets/projects/[a-z0-9][a-z0-9._-]*\\.(?:avif|webp)$"
            },
            "alt": { "type": "string", "minLength": 8, "maxLength": 240 },
            "width": { "type": "integer", "minimum": 320, "maximum": 2400 },
            "height": { "type": "integer", "minimum": 180, "maximum": 1800 },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": ["approvedBy", "reviewedAt"],
              "properties": {
                "approvedBy": { "const": "owner" },
                "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "image" } } },
              "then": { "required": ["src", "width", "height", "approval"] },
              "else": { "not": { "anyOf": [{ "required": ["src"] }, { "required": ["width"] }, { "required": ["height"] }, { "required": ["approval"] }] } }
            }
          ]
        }
      }
    },
    "galleryImage": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "src", "alt", "caption", "width", "height", "approval", "source"],
      "properties": {
        "kind": { "const": "image" },
        "src": { "type": "string", "pattern": "^assets/projects/[a-z0-9][a-z0-9._-]*\\.(?:avif|webp)$" },
        "alt": { "type": "string", "minLength": 8, "maxLength": 240 },
        "caption": { "type": "string", "minLength": 8, "maxLength": 500 },
        "width": { "type": "integer", "minimum": 320, "maximum": 2400 },
        "height": { "type": "integer", "minimum": 180, "maximum": 1800 },
        "approval": { "$ref": "#/$defs/presentation/properties/preview/properties/approval" },
        "source": { "$ref": "#/$defs/imageSource" }
      }
    },
    "imageSource": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "url", "capturedAt"],
          "properties": {
            "kind": { "const": "web" },
            "url": { "type": ["string", "null"], "pattern": "^https://", "maxLength": 500 },
            "capturedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "providedAt"],
          "properties": { "kind": { "const": "owner-provided" }, "providedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "capturedAt"],
          "properties": { "kind": { "const": "local-capture" }, "capturedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "collectedAt"],
          "properties": { "kind": { "const": "project-asset" }, "collectedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
        }
      ]
    },
    "activityMix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "items"],
      "properties": {
        "basis": { "enum": ["recorded-activities", "owner-estimate"] },
        "activityCount": { "type": "integer", "minimum": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "percentage"],
            "properties": {
              "domain": {
                "enum": ["frontend", "backend", "devops", "infrastructure", "data", "ai-ml", "mobile", "desktop", "embedded", "quality-engineering", "security", "developer-experience", "product-design", "other"]
              },
              "percentage": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
            }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "basis": { "const": "recorded-activities" } } },
        "then": { "required": ["activityCount"] },
        "else": { "not": { "required": ["activityCount"] } }
      }]
    }
  }
}
