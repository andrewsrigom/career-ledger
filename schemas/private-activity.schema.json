{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/private-activity.schema.json",
  "title": "Private career activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "id",
    "projectId",
    "workstreamId",
    "title",
    "summary",
    "occurredAt",
    "types",
    "domains",
    "significance",
    "progression",
    "attribution",
    "evidence",
    "outcomes",
    "areas",
    "technologies",
    "sensitivity",
    "sourceScans",
    "updatedAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "activity" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workstreamId": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 800
    },
    "occurredAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "build",
          "design",
          "architecture",
          "implementation",
          "investigation",
          "research",
          "migration",
          "optimization",
          "performance",
          "testing",
          "reliability",
          "security",
          "accessibility",
          "infrastructure",
          "automation",
          "integration",
          "maintenance",
          "refactoring",
          "leadership",
          "mentoring",
          "planning",
          "release",
          "product",
          "developer-experience",
          "documentation",
          "observability"
        ]
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "frontend",
          "backend",
          "devops",
          "infrastructure",
          "data",
          "ai-ml",
          "mobile",
          "desktop",
          "embedded",
          "quality-engineering",
          "security",
          "developer-experience",
          "product-design",
          "other"
        ]
      }
    },
    "significance": {
      "enum": ["activity", "notable", "milestone", "achievement"]
    },
    "progression": {
      "enum": ["started", "continued", "expanded", "completed", "revisited"]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "confidence", "notes"],
      "properties": {
        "scope": {
          "enum": ["implemented", "contributed", "designed", "led", "owned", "investigated"]
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "notes": {
          "type": "string",
          "maxLength": 1500
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "reference", "supports", "provenance"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": [
              "scan",
              "commit",
              "file",
              "diff",
              "pull-request",
              "branch",
              "test",
              "configuration",
              "architecture",
              "document",
              "dependency",
              "release",
              "deployment",
              "issue",
              "user-context",
              "manual-note",
              "public-source"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "supports": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "provenance": {
            "enum": ["observed", "provided", "derived", "inferred", "unverified"]
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "status", "evidenceLevel", "notes"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "status": {
            "enum": ["needs-confirmation", "confirmed", "rejected"]
          },
          "evidenceLevel": {
            "enum": ["unknown", "observed", "measured", "self-reported", "public"]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 80 }
    },
    "technologies": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "blockedTerms", "notes"],
      "properties": {
        "level": { "enum": ["low", "medium", "high"] },
        "blockedTerms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "notes": { "type": "string", "maxLength": 1500 }
      }
    },
    "sourceScans": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
