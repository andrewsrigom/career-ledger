{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/local-config.schema.json",
  "title": "Local Career Ledger configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "projects",
    "privacy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "gitIdentities"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "gitIdentities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "emails"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "emails": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email"
                }
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "path",
          "kind",
          "visibility",
          "contextFile",
          "scan"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "work",
              "personal",
              "open-source",
              "research"
            ]
          },
          "visibility": {
            "enum": [
              "private",
              "public-source"
            ]
          },
          "contextFile": {
            "type": "string",
            "minLength": 1
          },
          "scan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "since",
              "maxCommits",
              "includeUncommitted"
            ],
            "properties": {
              "since": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "maxCommits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "includeUncommitted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockedTerms",
        "blockedPatterns"
      ],
      "properties": {
        "blockedTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "blockedPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}
