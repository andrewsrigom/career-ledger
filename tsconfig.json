{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "types": [
      "astro/client",
      "node"
    ]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.ts",
    "playwright.config.ts",
    "tests/browser/**/*.ts"
  ],
  "exclude": [
    "dist",
    ".career",
    "node_modules"
  ]
}
